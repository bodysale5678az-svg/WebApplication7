@model WebApplication7.Models.Departement

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Departement</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            Students
        </dt>
        <dd class="col-sm-10">
            @if (Model.Students.Any())
            {
                <ul>
                    @foreach (var student in Model.Students)
                    {
                        <li>@student.Name</li>
                    }
                </ul>
            }
            else
            {
                <span>No students in this departement.</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
