@model WebApplication7.Models.Departement

@{
    ViewData["Title"] = "Department Details";
}

<h1>Details</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div>
    <h4>Department</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            Students
        </dt>
        <dd class="col-sm-10">
            @if (Model.Students != null && Model.Students.Any())
            {
                <span class="badge bg-primary">@Model.Students.Count</span>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
    </dl>
</div>

<hr />

<h4>Students in this department</h4>

@if (Model.Students != null )
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Students[0].Id)</th>
                <th>@Html.DisplayNameFor(model => model.Students[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.Students[0].Age)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students.OrderBy(s => s.Id))
            {
                <tr>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.Age</td>
                    <td>
                        <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id">View student</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">
        No students in this department.
        <a asp-controller="Student" asp-action="Create">Create a student</a> and assign it to this department.
    </p>
}

<hr />

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
