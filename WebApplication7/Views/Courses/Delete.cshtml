@model WebApplication7.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            Students
        </dt>
        <dd class="col-sm-10">
            @if (Model.Enrollments.Any())
            {
                @string.Join(", ", Model.Enrollments.Select(e => e.Student?.Name))
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
    </dl>

    @if (Model.Enrollments.Any())
    {
        <div class="alert alert-warning">
            This course has @Model.Enrollments.Count enrolment(s). Deleting it will remove them too.
        </div>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index">Back to List</a>
    </form>
</div>
