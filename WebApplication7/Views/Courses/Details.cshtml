@model WebApplication7.Models.Course

@{
    ViewData["Title"] = "Course Details";
    var enrolledIds = ViewBag.EnrolledIds as List<int> ?? new List<int>();
    var allStudents = ViewBag.AllStudents as List<WebApplication7.Models.Student> ?? new List<WebApplication7.Models.Student>();
    var enrollments = Model.Enrollments ?? new List<WebApplication7.Models.Enrollment>();
}

<h1>Details</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div>
    <h4>Course</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            Students
        </dt>
        <dd class="col-sm-10">
            @if (enrollments.Any())
            {
                <span class="badge bg-primary">@enrollments.Count</span>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
    </dl>
</div>

<hr />

<h4>Students enrolled</h4>

@if (enrollments.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Enrollments[0].Id)</th>
                <th>@Html.DisplayNameFor(model => model.Enrollments[0].Student.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Enrollments[0].Student.Age)</th>
                <th>@Html.DisplayNameFor(model => model.Enrollments[0].EnrolledOn)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in enrollments.OrderBy(e => e.StudentId))
            {
                <tr>
                    <td>@enrollment.Id</td>
                    <td>@(enrollment.Student?.Name ?? "-")</td>
                    <td>@(enrollment.Student?.Age ?? 0)</td>
                    <td>@enrollment.EnrolledOn.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-controller="Student" asp-action="Details" asp-route-id="@enrollment.StudentId">
                            View student
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No students enrolled in this course yet.</p>
}

<hr />

<h4>Manage Enrollment</h4>
<form asp-action="Enroll" asp-route-id="@Model.Id" method="post">
    @if (allStudents.Any())
    {
        @foreach (var student in allStudents)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="studentIds" value="@student.Id"
                       id="student_@student.Id" @(enrolledIds.Contains(student.Id) ? "checked" : "") />
                <label class="form-check-label" for="student_@student.Id">
                    @student.Name <span class="text-muted">(@student.Age yrs)</span>
                </label>
            </div>
        }
        <button type="submit" class="btn btn-primary mt-3">Save Enrollment</button>
    }
    else
    {
        <p>No students available. <a asp-controller="Student" asp-action="Create">Create a student first</a>.</p>
    }
</form>

<hr />

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
