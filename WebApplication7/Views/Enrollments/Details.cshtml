@model WebApplication7.Models.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<h1>Details</h1>

<div>
    <h4>Enrollment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student)
        </dt>
        <dd class="col-sm-10">
            <a asp-controller="Student" asp-action="Details" asp-route-id="@Model.StudentId">
                @(Model.Student?.Name ?? "-")
            </a>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Course)
        </dt>
        <dd class="col-sm-10">
            <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">
                @(Model.Course?.Name ?? "-")
            </a>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EnrolledOn)
        </dt>
        <dd class="col-sm-10">
            @Model.EnrolledOn.ToString("yyyy-MM-dd")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
